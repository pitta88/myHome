# --- .NET build output ---
bin/
obj/
publish/

# --- test output ---
TestResults/
*.trx
coverage.*.xml

# --- IDE / editor ---
.vs/
.idea/
*.user
*.suo
*.swp

# --- macOS ---
.DS_Store

# =====================================================================
# SECRETS — never commit
# =====================================================================
# docker-compose reads JWT_KEY / TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID
# from here. See .env.example for the shape.
.env
.env.local

# deploy/deploy.env.example is the template; the filled-in copy is private.
deploy/.env.deploy

# Real values belong in environment variables, not in a committed file.
appsettings.Production.json
appsettings.Local.json
**/appsettings.*.Local.json

# =====================================================================
# PRIVATE DATA — this is a personal home-maintenance log
# =====================================================================
# SQLite databases hold the admin password hash and personal notes.
*.db
*.db-wal
*.db-shm

# User-uploaded receipts, invoices and photos.
# 앞에 **/ 가 있어야 backend/MyHome.API/wwwroot/... 처럼 하위 경로에도 적용된다.
# (슬래시가 중간에 든 패턴은 .gitignore 위치 기준으로 고정되므로 루트만 매칭됨)
**/wwwroot/uploads/
**/wwwroot/photos/

# Local docker volume: a copy of the database plus the same uploads.
docker-data/

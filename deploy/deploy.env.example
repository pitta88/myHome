# deploy/.env.deploy 로 복사해서 채우세요 (git 커밋 금지)
#
# 이 파일은 비상용 수동 배포(deploy.sh)에서만 쓰입니다.
# 평소 배포는 `git push origin master` → GitHub Actions로 이뤄집니다.

SSH_HOST=1.2.3.4                      # EC2 Elastic IP
SSH_USER=ubuntu
SSH_KEY=~/.ssh/myhome-ec2.pem

# ECR 레지스트리 주소 (계정ID.dkr.ecr.<리전>.amazonaws.com)
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com

# 인스턴스 아키텍처. t4g(Graviton)=linux/arm64, t3(인텔)=linux/amd64
PLATFORM=linux/arm64

# Let's Encrypt 인증서를 자동 발급/갱신한다 (무료).
# DOMAIN, ACME_EMAIL, ACME_CA는 docker-compose가 환경변수로 주입한다.
{
	email {$ACME_EMAIL}

	# Let's Encrypt 프로덕션은 도메인당 주간 발급 한도와 시간당 실패 한도가 있다.
	# 설정을 고치며 재시도할 때 한도에 걸리지 않도록, 처음에는 .env에
	#   ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
	# 를 넣어 스테이징으로 검증한 뒤 (브라우저는 신뢰 안 함 — 경고가 정상),
	# 성공하면 그 줄을 지우고 재배포해 프로덕션 인증서를 받는다.
	# {$VAR:기본값} 문법 — ACME_CA가 없으면 프로덕션 주소가 쓰인다.
	# (그냥 {$ACME_CA}로 두면 값이 없을 때 인자가 사라져 Caddy가 문법
	#  오류로 기동에 실패하고 재시작 루프에 빠진다.)
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
}

{$DOMAIN} {
	encode zstd gzip

	# 업로드 파일 크기 제한 (원하는 값으로 조정)
	request_body {
		max_size 25MB
	}

	reverse_proxy myhome:8080 {
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 3
		}
	}
}
